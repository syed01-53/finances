# Railway production variables for the "finances" backend service.
# Set these in Railway → finances → Variables (NOT from .env.example).

# Link PostgreSQL first, then use a reference variable:
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Set after Vercel deploy (use your real Vercel URL):
CORS_ORIGINS=https://YOUR-APP.vercel.app

# Optional — allows Vercel preview deploy URLs (*.vercel.app):
CORS_ALLOW_VERCEL_PREVIEWS=true

LOG_LEVEL=INFO

# Do NOT set WEASYPRINT_DLL_DIRECTORIES on Railway (Windows-only).
