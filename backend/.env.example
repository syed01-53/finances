# =============================================================================
# LOCAL DEVELOPMENT ONLY — copy this file to .env on your machine.
# Do NOT add these values to Railway. Railway reads this file for suggestions
# but production values must come from Railway PostgreSQL + your Vercel URL.
# =============================================================================

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/aw_client_portal
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Windows only (local PDF via WeasyPrint) — never set on Railway/Linux:
# WEASYPRINT_DLL_DIRECTORIES=C:\msys64\mingw64\bin
